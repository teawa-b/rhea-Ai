{
  "name": "rhea-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rhea web client — WebXR globe + GPT-Live voice + Privy wallet. Railway service with Root Directory = frontend (served as a static site).",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0 --https",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
