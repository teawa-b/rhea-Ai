    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "@solana-program/memo": "^0.13.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.3.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "react": "~19.2.6",
    "react-dom": "~19.2.6",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
