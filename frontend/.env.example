# =====================================================================
#  FRONTEND — Railway service "frontend"  (Root Directory = frontend)
#  Locally: copy to frontend/.env
#  On Railway use the ready-to-paste block in DEPLOY.md instead.
#  Everything here ends up in the browser — never put secrets here.
#  VITE_* values are baked in at build time → redeploy after changing.
# =====================================================================

# Backend URL. Leave EMPTY locally (Vite proxies /api → localhost:5050).
# On Railway: https://${{ backend.RAILWAY_PUBLIC_DOMAIN }}
VITE_API_URL=

# Privy app id (public) — dashboard.privy.io
VITE_PRIVY_APP_ID=

# Solana RPC for the browser. Privy's confirm-and-send wallet screen needs this;
# the backend's SOLANA_RPC_URL never reaches the client. Baked into the bundle and
# therefore PUBLIC — use a separate, domain-restricted key, not the backend's.
# Unset = the public mainnet-beta endpoint, which is heavily rate limited.
VITE_SOLANA_RPC_URL=
# Optional websocket override; defaults to VITE_SOLANA_RPC_URL with http -> ws.
VITE_SOLANA_WS_URL=

# ?demo=1 guest mode: the PUBLIC address (never a private key) of the wallet
# that made the filmed trades. Visitors without sign-in get a read-only
# briefing and holdings for it; every trade path refuses in demo mode.
# Leave empty to make ?demo=1 fall back to the signed-out watchlist briefing.
VITE_DEMO_WALLET=
