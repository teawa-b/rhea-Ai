# =====================================================================
#  BACKEND — Railway service "backend"  (Root Directory = backend)
#  Locally: copy to backend/.env
#  On Railway use the ready-to-paste block in DEPLOY.md instead.
#  Do NOT set PORT — Railway injects it.
# =====================================================================

# ---- OpenAI (required for voice) ----
OPENAI_API_KEY=
# Front-end full-duplex voice model (fixed): gpt-live-1
OPENAI_LIVE_MODEL=gpt-live-1
# Backend reasoning model that GPT-Live delegates to (Responses delegation)
OPENAI_BACKEND_MODEL=gpt-5.6-terra
# Live voice: marin (default) | quartz | ripple | vesper | willow | stone | gleam | meridian
OPENAI_LIVE_VOICE=marin

# ---- CORS: which site(s) may call the API, comma-separated ----
# Leave EMPTY locally (allows any). On Railway: https://${{ frontend.RAILWAY_PUBLIC_DOMAIN }}
CORS_ORIGIN=

# ---- Solana ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Jupiter (optional; unlocks Swap V2 + Trigger V2 + stocks tag) ----
JUPITER_API_KEY=

# ---- Pyth Pro (optional; unlocks real-time equity feeds + OHLC history) ----
PYTH_PRO_API_KEY=

# ---- Google Street View Static (optional) ----
GOOGLE_MAPS_API_KEY=
